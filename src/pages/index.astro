---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Explore continuous casting with ASPIRE Labs. From molten steel and mold flow to the finished slab." />
    <meta name="theme-color" content="#0b1012" />
    <title>ASPIRE Labs — The science inside steel</title>
  </head>
  <body>
    <a class="skip-link" href="#team">Skip the casting experience</a>
    <header class="site-header">
      <a class="brand" href="#casting" aria-label="ASPIRE Labs home">
        <svg viewBox="0 0 40 42" fill="none" aria-hidden="true"><path d="M3 36 19 5h4l15 31H27l-7-16-8 16Z" fill="currentColor"/><path d="m14 29 6-5 6 5-6 5Z" fill="#ff793f"/></svg>
        <span><span class="brand-name">ASPIRE LABS</span><span class="brand-sub">Materials. Motion. Discovery.</span></span>
      </a>
      <nav class="header-links" aria-label="Main navigation"><a href="#casting">The process</a><a href="#team">Our people</a></nav>
      <span class="header-note">CONTINUOUS CASTING RESEARCH</span>
    </header>
    <main>
      <section class="scroll-track" id="casting" aria-label="Interactive continuous casting story">
        <div class="stage">
          <div class="scene-viewport" id="casting-viewport">
            <canvas id="casting-canvas" role="img" aria-label="Three-dimensional continuous casting line with tundish, copper mold, near-wall bubble tracers, curved roller segments, safety railings and a glowing ASPIRE LABS slab."></canvas>
            <div class="scene-fallback" role="img" aria-label="Casting process: tundish feeds a mold, the strand cools and exits onto rollers.">
              <span>TUNDISH</span><i></i><span>COPPER MOLD</span><i></i><span>COOLING &amp; WITHDRAWAL</span><i></i><strong>ASPIRE LABS / STEEL SLAB</strong>
              <p class="fallback-message">Preparing the casting line…</p>
            </div>
          </div>
          <div class="scene-meta"><span class="status-dot"></span> <span id="scene-view-label">01 / FRONT ELEVATION</span></div>
          <div class="scene-number" aria-hidden="true">AS / CC—01</div>
          <div class="story-copy">
            <article class="story-panel" data-chapter="0">
              <p class="eyebrow">FROM LIQUID TO POSSIBILITY</p>
              <h1>The science<br/>inside <span class="accent">steel.</span></h1>
              <div class="story-rule"></div>
              <p class="story-description">Extraordinary materials begin with the flow. Step inside the continuous casting process with ASPIRE Labs.</p>
              <p class="scroll-hint">SCROLL TO FOLLOW THE STEEL <span aria-hidden="true">↓</span></p>
            </article>
            <article class="story-panel" data-chapter="1" aria-hidden="true" inert>
              <p class="eyebrow">01 / INSIDE THE MOLD</p>
              <h2>A small flow.<br/><span class="accent">A lasting effect.</span></h2>
              <div class="story-rule"></div>
              <p class="story-description">Steel leaves the submerged entry nozzle and meets the narrow walls. Rising bubbles follow the wall to the surface; descending bubbles cling to the shell just below impact and disappear.</p>
              <p class="story-index">BUBBLE CAPTURE / SECTION VIEW</p>
            </article>
            <article class="story-panel" data-chapter="2" aria-hidden="true" inert>
              <p class="eyebrow">02 / SHAPING THE STRAND</p>
              <h2>Heat gives way<br/>to <span class="accent">structure.</span></h2>
              <div class="story-rule"></div>
              <p class="story-description">A solid shell forms against the cooled copper mold. Supporting rolls guide the strand through the cooling zone and into the horizontal runout.</p>
              <p class="story-index">SOLIDIFICATION / GUIDED WITHDRAWAL</p>
            </article>
            <article class="story-panel" data-chapter="3" aria-hidden="true" inert>
              <p class="eyebrow">03 / THE ROLLOUT</p>
              <h2>Research.<br/>Made <span class="accent">real.</span></h2>
              <div class="story-rule"></div>
              <p class="story-description">From the motion inside the mold to the slab on the roller table. A continuous journey, brought into perspective.</p>
              <p class="story-index">ASPIRE LABS / CONTINUOUS DISCOVERY</p>
            </article>
          </div>
          <p class="scene-caption"><span id="scene-detail">TUNDISH → SUBMERGED ENTRY NOZZLE</span><br/><span class="caption-muted">Illustrative process model · not to scale</span></p>
          <div class="scene-controls">
            <nav class="chapter-nav" aria-label="Casting chapters">
              <button type="button" data-jump="0" aria-current="step" aria-label="Go to overview">00 <span class="chapter-name">Overview</span></button>
              <button type="button" data-jump="0.29" aria-label="Go to mold flow">01 <span class="chapter-name">Mold flow</span></button>
              <button type="button" data-jump="0.59" aria-label="Go to cooling">02 <span class="chapter-name">Cooling</span></button>
              <button type="button" data-jump="0.94" aria-label="Go to rollout">03 <span class="chapter-name">Rollout</span></button>
            </nav>
            <button class="motion-toggle" type="button" aria-pressed="false">Pause motion <span aria-hidden="true">Ⅱ</span></button>
          </div>
          <div class="scroll-meter" aria-hidden="true"><div class="scroll-meter__bar"></div></div>
        </div>
      </section>
      <section class="team-section" id="team" aria-labelledby="team-heading">
        <div class="section-heading"><div><p class="eyebrow">THE PEOPLE BEHIND THE PROCESS</p><h2 id="team-heading">Curiosity drives us.</h2></div><p>Meet ASPIRE Labs.</p></div>
        <div class="team-grid">
            {
              team.map((member, index) => (
                <article class="team-card" data-card-index={index}>
                  <header class="team-card__header">
                    <h3>{member.name}</h3>
                    <p class="team-card__role">{member.role}</p>
                  </header>
                  <svg viewBox="0 0 120 120" role="img" aria-label={`${member.name} placeholder portrait`}>
                    <rect width="120" height="120" fill={member.hue} />
                    <circle cx="94" cy="22" r="30" fill={member.accent} opacity="0.28" />
                    <circle cx="30" cy="96" r="42" fill="#fff6e9" opacity="0.24" />
                    <path d="M31 104 C34 78 48 65 61 65 C75 65 89 78 92 104 Z" fill={member.accent} />
                    <circle cx="61" cy="47" r="23" fill="#ffe0bd" />
                    <path d="M38 43 C42 20 82 19 86 43 C75 33 53 33 38 43 Z" fill="#26323c" />
                    <circle cx="53" cy="48" r="3" fill="#17202a" />
                    <circle cx="69" cy="48" r="3" fill="#17202a" />
                    <path d="M53 58 Q61 64 70 58" fill="none" stroke="#9c4f39" stroke-linecap="round" stroke-width="3" />
                  </svg>
                  <p class="team-card__bio">{member.bio}</p>
                  <div class="team-card__links" aria-label={`${member.name} links`}>
                    {socialLinks.map((label) => (
                      <a href="#" aria-label={`${member.name} ${label}`}>
                        {label}
                      </a>
                    ))}
                  </div>
                </article>
              ))
            }

        </div>
      </section>
    </main>
    <footer><a class="brand-name" href="#casting">ASPIRE LABS</a><span>Continuous casting flow research</span><a href="#casting">Back to the process ↑</a></footer>
    <script>
      import { initCastingExperience } from '../scripts/casting-scene';
      initCastingExperience();
    </script>
  </body>
</html>
