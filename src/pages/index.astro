---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta
      name="description"
      content="ASPIRE Labs profile website proof of concept with scroll-driven continuous casting visuals."
    />
    <title>ASPIRE Labs</title>
  </head>
  <body>
    <main>
      <section class="scroll-track" aria-label="ASPIRE Labs continuous casting story">
        <div class="stage">
          <canvas id="flowCanvas" aria-hidden="true"></canvas>

          <svg
            class="caster-svg"
            viewBox="0 0 1440 900"
            preserveAspectRatio="xMidYMid slice"
            role="img"
            aria-label="Cartoon cross-section of a continuous casting system from tundish to mold to rollers"
          >
            <defs>
              <linearGradient id="wallGrad" x1="0" x2="1">
                <stop offset="0" stop-color="#4b4a48" />
                <stop offset="0.45" stop-color="#9b9188" />
                <stop offset="1" stop-color="#2c2f35" />
              </linearGradient>
              <linearGradient id="copperGrad" x1="0" x2="0" y1="0" y2="1">
                <stop offset="0" stop-color="#f3a24d" />
                <stop offset="0.52" stop-color="#b96a27" />
                <stop offset="1" stop-color="#6f3a1c" />
              </linearGradient>
              <linearGradient id="steelGrad" x1="0" x2="1">
                <stop offset="0" stop-color="#dce3ea" />
                <stop offset="0.42" stop-color="#909ca8" />
                <stop offset="1" stop-color="#59636f" />
              </linearGradient>
              <linearGradient id="waterWallGrad" x1="0" x2="1">
                <stop offset="0" stop-color="#b8f3ff" stop-opacity="0.42" />
                <stop offset="0.5" stop-color="#eefcff" stop-opacity="0.72" />
                <stop offset="1" stop-color="#69bfd4" stop-opacity="0.5" />
              </linearGradient>
              <linearGradient id="slabGrad" x1="0" x2="1">
                <stop offset="0" stop-color="#cfd6dc" />
                <stop offset="0.38" stop-color="#8c98a3" />
                <stop offset="0.68" stop-color="#eef2f5" />
                <stop offset="1" stop-color="#6e7782" />
              </linearGradient>
              <filter id="softShadow" x="-20%" y="-20%" width="140%" height="150%">
                <feDropShadow dx="0" dy="18" stdDeviation="16" flood-color="#080b10" flood-opacity="0.26" />
              </filter>
              <marker id="arrowHot" viewBox="0 0 12 12" refX="10" refY="6" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
                <path d="M1 1 11 6 1 11Z" fill="#ff7a1f" />
              </marker>
              <marker id="arrowCool" viewBox="0 0 12 12" refX="10" refY="6" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
                <path d="M1 1 11 6 1 11Z" fill="#1aa4bd" />
              </marker>
              <pattern id="hatch" width="18" height="18" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
                <line x1="0" y1="0" x2="0" y2="18" stroke="rgba(255,255,255,0.18)" stroke-width="4" />
              </pattern>
            </defs>

            <g id="machineWorld">
              <g id="tundishScene" filter="url(#softShadow)">
