                <path d="M528 170 H912" stroke="#fff7e9" stroke-linecap="round" stroke-width="7" />
                <path d="M684 0 H756 V372 Q756 397 720 397 Q684 397 684 372 Z" fill="#262121" stroke="#f5e8d1" stroke-width="7" />
                <path d="M711 24 H729 V346" stroke="#ffe1ad" stroke-linecap="round" stroke-width="9" opacity="0.62" />
                <path d="M664 332 H776 V384 H664 Z" fill="#262121" stroke="#f5e8d1" stroke-linejoin="round" stroke-width="7" />
                <path d="M664 358 C612 362 579 386 548 432" class="flow-arrow" marker-end="url(#arrowHot)" stroke="#ff7a1f" />
                <path d="M776 358 C828 362 861 386 892 432" class="flow-arrow" marker-end="url(#arrowHot)" stroke="#ff7a1f" />
                <path d="M632 437 C530 498 536 606 631 655" class="flow-arrow" marker-end="url(#arrowHot)" stroke="#ff9d2f" opacity="0.9" />
                <path d="M808 437 C910 498 904 606 809 655" class="flow-arrow" marker-end="url(#arrowHot)" stroke="#ff9d2f" opacity="0.9" />
                <path d="M530 808 C601 845 839 845 910 808" fill="none" stroke="#f4ead7" stroke-width="6" stroke-linecap="round" />
              </g>

              <g id="waterLabScene" transform="translate(0 1480)" opacity="0">
                <path d="M382 78 H1058 V842 H382 Z" fill="rgba(220,252,255,0.1)" stroke="#c5f6ff" stroke-width="7" />
                <path d="M452 128 H988 V800 H452 Z" fill="url(#waterWallGrad)" stroke="#f4ffff" stroke-width="4" />
                <path d="M684 28 H756 V382 Q756 407 720 407 Q684 407 684 382 Z" fill="#f5f8f8" stroke="#71808c" stroke-width="7" />
                <path d="M664 344 H776 V396 H664 Z" fill="#e5eeee" stroke="#71808c" stroke-linejoin="round" stroke-width="7" />
                <path d="M452 172 H988" stroke="#ffffff" stroke-linecap="round" stroke-width="7" />
                <path d="M544 190 C605 275 592 608 634 798 H544 Z" fill="#79d9ec" opacity="0.6" />
                <path d="M896 190 C835 275 848 608 806 798 H896 Z" fill="#79d9ec" opacity="0.6" />
                <path d="M661 370 C604 390 570 424 538 480" class="flow-arrow" marker-end="url(#arrowCool)" stroke="#1aa4bd" />
                <path d="M779 370 C836 390 870 424 902 480" class="flow-arrow" marker-end="url(#arrowCool)" stroke="#1aa4bd" />
                <path d="M632 492 C532 560 555 664 650 704" class="flow-arrow" marker-end="url(#arrowCool)" stroke="#20b7cf" opacity="0.85" />
                <path d="M808 492 C908 560 885 664 790 704" class="flow-arrow" marker-end="url(#arrowCool)" stroke="#20b7cf" opacity="0.85" />
                <text class="cool-note" x="720" y="888" text-anchor="middle">water model flow similarity</text>
              </g>

              <g id="casterExit" transform="translate(0 2265)" opacity="0">
                <text class="machine-label" x="720" y="72" fill="#eef8ff" text-anchor="middle">
                  strand support and withdrawal
                </text>
                <path d="M440 268 C570 356 772 378 980 340" fill="none" stroke="#4c5967" stroke-width="46" stroke-linecap="round" opacity="0.5" />
                <path d="M412 292 C570 388 772 410 1008 368" fill="none" stroke="#12191f" stroke-width="16" stroke-linecap="round" opacity="0.55" />

                <g fill="url(#steelGrad)" stroke="#1d2730" stroke-width="5">
                  <g transform="translate(408 224) rotate(20)">
                    <ellipse cx="0" cy="0" rx="46" ry="19" />
                    <path d="M-46 0 v38 c0 11 21 20 46 20 s46 -9 46 -20 V0" fill="#687684" />
                    <ellipse cx="0" cy="38" rx="46" ry="19" fill="#9aa6b0" />
                  </g>
                  <g transform="translate(505 278) rotate(16)">
                    <ellipse cx="0" cy="0" rx="46" ry="19" />
                    <path d="M-46 0 v38 c0 11 21 20 46 20 s46 -9 46 -20 V0" fill="#687684" />
                    <ellipse cx="0" cy="38" rx="46" ry="19" fill="#9aa6b0" />
                  </g>
                  <g transform="translate(614 318) rotate(9)">
                    <ellipse cx="0" cy="0" rx="48" ry="20" />
                    <path d="M-48 0 v40 c0 11 22 20 48 20 s48 -9 48 -20 V0" fill="#687684" />
                    <ellipse cx="0" cy="40" rx="48" ry="20" fill="#9aa6b0" />
                  </g>
                  <g transform="translate(730 336) rotate(2)">
                    <ellipse cx="0" cy="0" rx="48" ry="20" />
                    <path d="M-48 0 v40 c0 11 22 20 48 20 s48 -9 48 -20 V0" fill="#687684" />
                    <ellipse cx="0" cy="40" rx="48" ry="20" fill="#9aa6b0" />
                  </g>
                  <g transform="translate(848 328) rotate(-6)">
                    <ellipse cx="0" cy="0" rx="48" ry="20" />
                    <path d="M-48 0 v40 c0 11 22 20 48 20 s48 -9 48 -20 V0" fill="#687684" />
                    <ellipse cx="0" cy="40" rx="48" ry="20" fill="#9aa6b0" />
                  </g>
                  <g transform="translate(964 300) rotate(-10)">
                    <ellipse cx="0" cy="0" rx="48" ry="20" />
                    <path d="M-48 0 v40 c0 11 22 20 48 20 s48 -9 48 -20 V0" fill="#687684" />
                    <ellipse cx="0" cy="40" rx="48" ry="20" fill="#9aa6b0" />
                  </g>
                </g>

                <g id="finalSlab" filter="url(#softShadow)">
                  <path d="M448 502 L1016 348 L1195 438 L626 596 Z" fill="url(#slabGrad)" stroke="#eef6fb" stroke-linejoin="round" stroke-width="5" />
                  <path d="M626 596 L1195 438 L1195 502 L626 660 Z" fill="#67717c" stroke="#3a4651" stroke-linejoin="round" stroke-width="4" />
                  <path d="M448 502 L626 596 L626 660 L448 566 Z" fill="#8e99a3" stroke="#3a4651" stroke-linejoin="round" stroke-width="4" />
                  <text
                    x="806"
                    y="497"
                    fill="#26323c"
                    font-size="58"
                    font-weight="900"
                    letter-spacing="0"
                    text-anchor="middle"
                    transform="rotate(-14 806 497) skewX(-8)"
                  >
                    ASPIRE Labs
                  </text>
                </g>
              </g>
            </g>
          </svg>

          <div class="hero-copy">
            <h1 class="hero-title">ASPIRE Labs</h1>
            <p class="hero-kicker">Continuous casting flow research</p>
          </div>

          <aside class="team-strip" aria-label="Team biographies">
            {
              team.map((member, index) => (
                <article class="team-card" data-card-index={index}>
                  <svg viewBox="0 0 120 120" role="img" aria-label={`${member.name} placeholder portrait`}>
                    <rect width="120" height="120" fill={member.hue} />
                    <circle cx="94" cy="22" r="30" fill={member.accent} opacity="0.28" />
                    <circle cx="30" cy="96" r="42" fill="#fff6e9" opacity="0.24" />
                    <path d="M31 104 C34 78 48 65 61 65 C75 65 89 78 92 104 Z" fill={member.accent} />
                    <circle cx="61" cy="47" r="23" fill="#ffe0bd" />
                    <path d="M38 43 C42 20 82 19 86 43 C75 33 53 33 38 43 Z" fill="#26323c" />
                    <circle cx="53" cy="48" r="3" fill="#17202a" />
                    <circle cx="69" cy="48" r="3" fill="#17202a" />
                    <path d="M53 58 Q61 64 70 58" fill="none" stroke="#9c4f39" stroke-linecap="round" stroke-width="3" />
                  </svg>
                  <div>
                    <p class="team-card__role">{member.role}</p>
                    <h2>{member.name}</h2>
                    <p>{member.bio}</p>
                  </div>
                </article>
              ))
            }
          </aside>

          <div class="scroll-meter" aria-hidden="true">
            <div class="scroll-meter__bar"></div>
          </div>
        </div>
      </section>
    </main>

    <script>
      import gsap from "gsap";
      import { ScrollTrigger } from "gsap/ScrollTrigger";

      gsap.registerPlugin(ScrollTrigger);

      type FlowParticle = {
        x: number;
        y: number;
        vx: number;
        vy: number;
        r: number;
        phase: number;
      };

      const root = document.documentElement;
      const track = document.querySelector<HTMLElement>(".scroll-track");
      const hero = document.querySelector<HTMLElement>(".hero-copy");
      const world = document.querySelector<SVGGElement>("#machineWorld");
      const cards = gsap.utils.toArray<HTMLElement>(".team-card");
      const canvas = document.querySelector<HTMLCanvasElement>("#flowCanvas");
      const meter = document.querySelector<HTMLElement>(".scroll-meter__bar");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (track && hero && world && canvas && meter && !reducedMotion) {
        const ctx = canvas.getContext("2d");
        const state = {
          progress: 0,
          time: 0,
          mouseX: window.innerWidth / 2,
          mouseY: window.innerHeight / 2,
          slosh: 0
        };

        const particles: FlowParticle[] = Array.from({ length: 92 }, (_, index) => ({
          x: Math.random(),
          y: Math.random(),
          vx: (Math.random() - 0.5) * 0.26,
          vy: 0.18 + Math.random() * 0.42,
          r: 1.4 + Math.random() * 3.2,
          phase: index * 0.41
        }));

        const resizeCanvas = () => {
          const dpr = Math.min(window.devicePixelRatio || 1, 2);
          const width = Math.floor(window.innerWidth * dpr);
          const height = Math.floor(window.innerHeight * dpr);

          if (canvas.width !== width || canvas.height !== height) {
            canvas.width = width;
            canvas.height = height;
            canvas.style.width = `${window.innerWidth}px`;
            canvas.style.height = `${window.innerHeight}px`;
            ctx?.setTransform(dpr, 0, 0, dpr, 0, 0);
          }
        };

        const smoothstep = (edge0: number, edge1: number, value: number) => {
          const x = Math.min(Math.max((value - edge0) / (edge1 - edge0), 0), 1);
          return x * x * (3 - 2 * x);
        };

        const sceneTransform = () => {
          const width = window.innerWidth;
          const height = window.innerHeight;
          const scale = Math.max(width / 1440, height / 900);
          const offsetX = (width - 1440 * scale) / 2;
          const offsetY = (height - 900 * scale) / 2;
          const worldX = Number(gsap.getProperty(world, "x")) || 0;
          const worldY = Number(gsap.getProperty(world, "y")) || 0;
          return {
            scale,
            x: (value: number) => offsetX + (value + worldX) * scale,
            y: (value: number) => offsetY + (value + worldY) * scale
          };
        };

        const drawTundishFluid = (context: CanvasRenderingContext2D, now: number) => {
          const fade = 1 - smoothstep(0.11, 0.25, state.progress);
          if (fade <= 0.01) return;

          const t = sceneTransform();
          const clip = [
            [338, 216],
            [1102, 216],
            [1034, 352],
            [836, 352],
            [790, 418],
            [650, 418],
            [604, 352],
            [406, 352]
          ];
          const mouseTarget = ((state.mouseX / window.innerWidth) - 0.5) * 56;
          state.slosh += (mouseTarget - state.slosh) * 0.045;

          context.save();
          context.globalAlpha = fade;
          context.beginPath();
          clip.forEach(([x, y], index) => {
            if (index === 0) context.moveTo(t.x(x), t.y(y));
            else context.lineTo(t.x(x), t.y(y));
          });
          context.closePath();
          context.clip();

          const left = t.x(330);
          const right = t.x(1110);
          const top = t.y(260);
          const bottom = t.y(426);
          const gradient = context.createLinearGradient(0, top, 0, bottom);
          gradient.addColorStop(0, "#ffe16a");
          gradient.addColorStop(0.45, "#ff8b24");
          gradient.addColorStop(1, "#d83e1f");

          context.beginPath();
          for (let i = 0; i <= 42; i += 1) {
            const ratio = i / 42;
            const x = left + (right - left) * ratio;
            const worldWave = Math.sin(ratio * Math.PI * 5.4 + now * 0.0027) * 9;
            const mouseWave = (ratio - 0.5) * state.slosh;
            const y = top + (worldWave + mouseWave) * t.scale;
            if (i === 0) context.moveTo(x, y);
            else context.lineTo(x, y);
          }
          context.lineTo(right, bottom);
          context.lineTo(left, bottom);
          context.closePath();
          context.fillStyle = gradient;
          context.fill();

          context.globalCompositeOperation = "screen";
          context.strokeStyle = "rgba(255, 255, 214, 0.7)";
          context.lineWidth = 3 * t.scale;
          context.beginPath();
          for (let i = 0; i <= 42; i += 1) {
            const ratio = i / 42;
            const x = left + (right - left) * ratio;
            const y = top + (Math.sin(ratio * Math.PI * 5.4 + now * 0.0027) * 9 + (ratio - 0.5) * state.slosh) * t.scale;
            if (i === 0) context.moveTo(x, y);
            else context.lineTo(x, y);
          }
          context.stroke();
          context.restore();

          context.save();
          context.globalAlpha = fade * 0.72;
          context.strokeStyle = "#ff7a1f";
          context.lineCap = "round";
          context.lineWidth = Math.max(7, 11 * t.scale);
          [
            [638, 458, 638, 540],
            [720, 482, 720, 660],
            [802, 458, 802, 540]
          ].forEach(([x1, y1, x2, y2], index) => {
            context.beginPath();
            context.moveTo(t.x(x1), t.y(y1));
            const bend = Math.sin(now * 0.003 + index) * 16;
            context.bezierCurveTo(t.x(x1 + bend), t.y(y1 + 34), t.x(x2 - bend), t.y(y2 - 32), t.x(x2), t.y(y2));
            context.stroke();
          });
          context.restore();
        };

        const drawMoldFlow = (context: CanvasRenderingContext2D, now: number) => {
          const hot = smoothstep(0.12, 0.32, state.progress) * (1 - smoothstep(0.58, 0.78, state.progress));
          if (hot <= 0.01) return;

          const t = sceneTransform();
          const moldY = 740;
          context.save();
          context.globalAlpha = hot * 0.78;
          context.lineCap = "round";
          context.lineJoin = "round";
          context.lineWidth = Math.max(11, 18 * t.scale);
          context.strokeStyle = state.progress < 0.56 ? "#ff8424" : "#28b9cf";

          const pulse = Math.sin(now * 0.004) * 14;
          const paths = [
            [720, moldY + 350, 606, moldY + 408, 564, moldY + 520, 640, moldY + 650],
            [720, moldY + 350, 834, moldY + 408, 876, moldY + 520, 800, moldY + 650],
            [720, moldY + 386, 670, moldY + 504, 662, moldY + 636, 720, moldY + 770],
            [720, moldY + 386, 770, moldY + 504, 778, moldY + 636, 720, moldY + 770]
          ];

          paths.forEach(([x1, y1, cx1, cy1, cx2, cy2, x2, y2], index) => {
            context.beginPath();
            context.moveTo(t.x(x1), t.y(y1));
            context.bezierCurveTo(
              t.x(cx1 + Math.sin(index + now * 0.001) * 11),
              t.y(cy1 + pulse),
              t.x(cx2 - Math.cos(index + now * 0.0012) * 10),
              t.y(cy2 - pulse),
              t.x(x2),
              t.y(y2)
            );
            context.stroke();
          });
          context.restore();
        };

        const drawWaterWash = (context: CanvasRenderingContext2D) => {
          const amount = smoothstep(0.48, 0.64, state.progress) * (1 - smoothstep(0.86, 0.98, state.progress));
          if (amount <= 0.01) return;

          const height = window.innerHeight;
          const width = window.innerWidth;
          const washY = -height + height * 1.45 * amount;
          const gradient = context.createLinearGradient(0, washY, 0, washY + height);
          gradient.addColorStop(0, "rgba(226, 252, 255, 0)");
          gradient.addColorStop(0.34, "rgba(108, 210, 229, 0.26)");
          gradient.addColorStop(0.62, "rgba(44, 174, 201, 0.46)");
          gradient.addColorStop(1, "rgba(237, 252, 255, 0.18)");

          context.save();
          context.fillStyle = gradient;
          context.fillRect(0, washY, width, height * 1.1);
          context.globalAlpha = amount * 0.5;
          context.strokeStyle = "rgba(239, 255, 255, 0.74)";
          context.lineWidth = 2;
          for (let i = 0; i < 22; i += 1) {
            const x = (i / 21) * width + Math.sin(i * 2.1 + state.time * 0.001) * 20;
            context.beginPath();
            context.moveTo(x, Math.max(0, washY + 30));
            context.bezierCurveTo(x + 28, washY + height * 0.28, x - 24, washY + height * 0.62, x + 10, washY + height);
            context.stroke();
          }
          context.restore();
        };

        const drawParticles = (context: CanvasRenderingContext2D, now: number) => {
          const cool = smoothstep(0.52, 0.72, state.progress);
          const width = window.innerWidth;
          const height = window.innerHeight;

          context.save();
          particles.forEach((particle) => {
            particle.y += particle.vy * (cool ? -0.18 : 0.24);
            particle.x += particle.vx * 0.004 + Math.sin(now * 0.001 + particle.phase) * 0.0006;

            if (!cool && particle.y > 1.08) particle.y = -0.06;
            if (cool && particle.y < -0.06) particle.y = 1.08;
            if (particle.x < -0.04) particle.x = 1.04;
            if (particle.x > 1.04) particle.x = -0.04;

            const x = particle.x * width;
            const y = particle.y * height;
            const r = particle.r * (cool ? 1.25 : 1);
            context.globalAlpha = cool ? 0.22 : 0.36 * (1 - smoothstep(0.58, 0.82, state.progress));
            context.fillStyle = cool ? "rgba(220, 252, 255, 0.82)" : "rgba(255, 174, 68, 0.88)";
            context.beginPath();
            context.arc(x, y, r, 0, Math.PI * 2);
            context.fill();
          });
          context.restore();
        };

        const render = (now: number) => {
          state.time = now;
          resizeCanvas();
          if (ctx) {
            ctx.clearRect(0, 0, window.innerWidth, window.innerHeight);
            drawWaterWash(ctx);
            drawTundishFluid(ctx, now);
            drawMoldFlow(ctx, now);
            drawParticles(ctx, now);
          }
          window.requestAnimationFrame(render);
        };

        gsap.set(cards, { autoAlpha: 0, xPercent: 130, rotate: -2 });
        gsap.set("#casterExit", { transformOrigin: "720px 420px", scale: 0.92 });
        gsap.set(meter, { scaleX: 0 });

        const timeline = gsap.timeline({
          defaults: { ease: "none" },
          scrollTrigger: {
            trigger: track,
            start: "top top",
            end: "bottom bottom",
            scrub: 0.85,
            onUpdate: (self) => {
              state.progress = self.progress;
            }
          }
        });

        timeline
          .to(meter, { scaleX: 1, duration: 5.2 }, 0)
          .to(hero, { autoAlpha: 0, y: -42, duration: 0.55 }, 0.14)
          .to(world, { y: -690, duration: 1.15 }, 0)
          .to("#moldScene", { autoAlpha: 1, duration: 0.45 }, 0.42)
          .to(world, { y: -1400, duration: 1.05 }, 1.15)
          .to(root, { "--thermal-mix": 1, duration: 1.05 }, 1.42)
          .to("#waterLabScene", { autoAlpha: 1, duration: 0.5 }, 1.52)
          .to(world, { y: -2380, duration: 1.2 }, 3.84)
          .to("#casterExit", { autoAlpha: 1, scale: 1.04, x: 40, duration: 0.9 }, 4.08)
          .to("#finalSlab", { x: 44, y: -18, duration: 0.65 }, 4.64);

        cards.forEach((card, index) => {
          const start = 1.62 + index * 0.31;
          timeline
            .to(card, { autoAlpha: 1, xPercent: 0, rotate: 0, duration: 0.12, ease: "power2.out" }, start)
            .to(card, { xPercent: -172, autoAlpha: 0, duration: 0.17, ease: "power1.in" }, start + 0.16);
        });

        window.addEventListener("pointermove", (event) => {
          state.mouseX = event.clientX;
          state.mouseY = event.clientY;
        });
        window.addEventListener("resize", () => {
          resizeCanvas();
          ScrollTrigger.refresh();
        });

        resizeCanvas();
        window.requestAnimationFrame(render);
      } else if (reducedMotion) {
        root.style.setProperty("--thermal-mix", "0.65");
      }
    </script>
  </body>
</html>
